# Copy this file to .env and fill in real values before running.
# NEVER commit your real .env file to version control.

# Port the server listens on
PORT=3000

# A long, random, secret string used to sign JWT auth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# How long a login session lasts
JWT_EXPIRES_IN=7d

# Set to "production" when deployed on your host (enables secure cookies, etc.)
NODE_ENV=development

# The public URL of your deployed site (used for CORS + cookie settings)
CLIENT_URL=http://localhost:3000
